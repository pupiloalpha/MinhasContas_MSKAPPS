<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.msk.minhascontas">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:backupAgent="com.msk.minhascontas.utils.BackupAgent"
        android:enableOnBackInvokedCallback="true"
        android:configChanges="orientation"
        android:requestLegacyExternalStorage="true"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:restoreAnyVersion="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinhasContas"
        android:uiOptions="splitActionBarWhenNarrow">
        <activity
            android:name=".features.info.SplashScreen"
            android:exported="true"
            android:theme="@style/SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MinhasContas"
            android:exported="false" />
        <activity
            android:name=".db.CriarConta"
            android:exported="true"
            android:label="@string/titulo_criar">
            <intent-filter>
                <action android:name="com.msk.minhascontas.NOVACONTA" />
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".db.EditarConta"
            android:exported="true"
            android:label="@string/titulo_editar">
            <intent-filter>
                <action android:name="com.msk.minhascontas.EDITACONTA" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.listas.PesquisaContas"
            android:exported="true"
            android:label="@string/titulo_pesquisar">
            <intent-filter>
                <action android:name="com.msk.minhascontas.BUSCACONTA" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.info.Sobre"
            android:exported="true"
            android:label="@string/menu_sobre">
            <intent-filter>
                <action android:name="com.msk.minhascontas.SOBRE" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.info.Ajustes"
            android:exported="false"
            android:label="@string/menu_ajustes">
            <intent-filter>
                <action android:name="com.msk.minhascontas.AJUSTES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.auth.LoginGoogle"
            android:exported="false"
            android:label="@string/pref_titulo_google_login" />
        <activity
            android:name=".features.planos.PersonalizarCategorias"
            android:exported="false"
            android:label="@string/titulo_personalizar_categorias" />
        <activity
            android:name=".features.planos.PlanejamentoFinanceiro"
            android:exported="false"
            android:label="@string/titulo_planejamento_financeiro" />
        <activity
            android:name=".features.planos.PlanoFinanceiroActivity"
            android:exported="false"
            android:label="@string/coach_title_dashboard" />
        <activity
            android:name=".features.listas.PaginadorListas"
            android:exported="false" />
        <activity
            android:name=".features.graficos.PaginadorGraficos"
            android:exported="false" />
        <activity
            android:name=".features.planos.PaginadorMetas"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.backup.api_key"
            android:value="AEdPqrEAAAAIpHF2O26UlB5OMWy7l025hyqZ73sZvLmiH3HErQ" />

        <service android:name=".features.servicos.NotificationImportService"
            android:label="@string/pref_titulo_notificacao"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Widget: Adicionador de Contas -->
        <receiver
            android:name=".features.widget.AddContaWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_conta_widget_info" />
        </receiver>

        <!-- Widget: Resumo Mensal -->
        <receiver
            android:name=".features.widget.ResumoMensalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resumo_mensal_widget_info" />
        </receiver>
    </application>

</manifest>
